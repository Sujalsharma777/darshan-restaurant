generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum DiningTableStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TablePreference {
  ANY
  WINDOW
  INDOOR
  OUTDOOR
}

/// Order lifecycle: UPCOMING → ACKNOWLEDGED → PREPARING → READY → COMPLETED.
/// CANCELLED (customer before PREPARING, or restaurant any time before COMPLETED) and
/// REJECTED (restaurant, only while UPCOMING) are the other terminal states.
enum BookingStatus {
  UPCOMING
  ACKNOWLEDGED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REJECTED
}

enum BookingActor {
  CUSTOMER
  RESTAURANT
}

enum CancellationReason {
  CHANGE_OF_PLANS
  BOOKED_BY_MISTAKE
  FOUND_BETTER_OPTION
  RESTAURANT_NOT_RESPONDING
  OTHER
}

enum PaymentStatus {
  CREATED
  VERIFIED
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_MODIFIED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_ACKNOWLEDGED
  BOOKING_PREPARING
  BOOKING_READY
  BOOKING_COMPLETED
  BOOKING_REJECTED
}

model RestaurantUser {
  id            String   @id @default(uuid())
  phone         String   @unique
  name          String
  email         String?
  playerId      String?  @map("player_id")
  centralUserId Int?     @unique @map("central_user_id")
  /// Language the customer last used in the app; push notifications are sent in it.
  language      String   @default("en") @db.VarChar(8)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookings        RestaurantBooking[]
  payments        Payment[]
  refreshSessions RefreshSession[]
  notifications   Notification[]
  wishlist        RestaurantWishlist[]
  reviews         RestaurantReview[]

  @@map("restaurant_users")
}

model RefreshSession {
  id               String    @id @default(uuid())
  restaurantUserId String    @map("restaurant_user_id")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  restaurantUser RestaurantUser @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)

  @@index([restaurantUserId])
  @@map("refresh_sessions")
}

model AdminUser {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  passwordHash        String       @map("password_hash")
  role                AdminRole    @default(ADMIN)
  status              RecordStatus @default(ACTIVE)
  /// Last time this admin opened the new-bookings notification panel; bookings created after it count as unread.
  notificationsSeenAt DateTime?    @map("notifications_seen_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  restaurants AdminRestaurant[]

  @@map("admin_users")
}

model AdminRestaurant {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  admin      AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([adminId, restaurantId])
  @@index([restaurantId])
  @@map("admin_restaurants")
}

model RestaurantCategory {
  id           String   @id @default(uuid())
  key          String   @unique
  label        String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  /// Non-English copies of the text fields, e.g. { "hi": { "name": "..." } }. English lives in the regular columns.
  translations Json?
  createdAt    DateTime @default(now()) @map("created_at")

  restaurants RestaurantCategoryLink[]

  @@map("restaurant_categories")
}

model RestaurantCategoryLink {
  id           String @id @default(uuid())
  restaurantId String @map("restaurant_id")
  categoryId   String @map("category_id")

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, categoryId])
  @@index([categoryId])
  @@map("restaurant_category_links")
}

model Restaurant {
  id              String       @id @default(uuid())
  name            String
  banner          String?      @db.VarChar(1024)
  gallery         Json?
  cuisineLabel    String       @map("cuisine_label")
  isPureVeg       Boolean      @default(false) @map("is_pure_veg")
  rating          Decimal      @default(0) @db.Decimal(2, 1)
  ratingCount     Int          @default(0) @map("rating_count")
  prepTimeMin     Int          @map("prep_time_min")
  prepTimeMax     Int          @map("prep_time_max")
  priceForTwo     Int          @map("price_for_two")
  offerText       String?      @map("offer_text")
  offerSubText    String?      @map("offer_sub_text")
  about           String?      @db.Text
  /// Non-English copies of the text fields, e.g. { "hi": { "name": "..." } }. English lives in the regular columns.
  translations    Json?
  addressLine     String       @map("address_line")
  city            String
  state           String?
  country         String       @default("India")
  pincode         String?
  phone           String
  latitude        Decimal      @db.Decimal(10, 7)
  longitude       Decimal      @db.Decimal(10, 7)
  seatingCapacity Int          @default(40) @map("seating_capacity")
  /// Daily opening/closing wall-clock time ("HH:mm", business timezone); arrival times must fall inside it.
  opensAt         String       @default("09:00") @map("opens_at") @db.VarChar(5)
  closesAt        String       @default("23:00") @map("closes_at") @db.VarChar(5)
  maxPartySize    Int          @default(12) @map("max_party_size")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  categories     RestaurantCategoryLink[]
  menuCategories MenuCategory[]
  tables         DiningTable[]
  bookings       RestaurantBooking[]
  admins         AdminRestaurant[]
  wishlistedBy   RestaurantWishlist[]
  reviews        RestaurantReview[]

  @@index([city, status])
  @@map("restaurants")
}

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  /// Non-English copies of the text fields, e.g. { "hi": { "name": "..." } }. English lives in the regular columns.
  translations Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(uuid())
  menuCategoryId String   @map("menu_category_id")
  name           String
  description    String?  @db.Text
  /// Non-English copies of the text fields, e.g. { "hi": { "name": "..." } }. English lives in the regular columns.
  translations   Json?
  price          Decimal  @db.Decimal(10, 2)
  image          String?  @db.VarChar(1024)
  isVeg          Boolean  @default(true) @map("is_veg")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)

  @@index([menuCategoryId, sortOrder])
  @@map("menu_items")
}

model DiningTable {
  id           String            @id @default(uuid())
  restaurantId String            @map("restaurant_id")
  name         String
  capacity     Int
  preference   TablePreference   @default(ANY)
  section      String?
  status       DiningTableStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bookings   RestaurantBooking[]

  @@unique([restaurantId, name])
  @@index([restaurantId, status])
  @@map("dining_tables")
}

model RestaurantBooking {
  id                      String              @id @default(uuid())
  humanBookingId          String              @unique @map("human_booking_id")
  restaurantId            String              @map("restaurant_id")
  restaurantUserId        String              @map("restaurant_user_id")
  restaurantNameSnapshot  String              @map("restaurant_name_snapshot")
  restaurantImageSnapshot String?             @map("restaurant_image_snapshot") @db.VarChar(1024)
  ratingSnapshot          Decimal             @map("rating_snapshot") @db.Decimal(2, 1)
  cuisineLabelSnapshot    String              @map("cuisine_label_snapshot")
  /// Restaurant name/cuisine translations as they were when the order was placed.
  translationsSnapshot    Json?               @map("translations_snapshot")
  distanceKmSnapshot      Decimal?            @map("distance_km_snapshot") @db.Decimal(6, 2)
  /// Arrival date (always the booking day — same-day orders only) and arrival time "HH:mm".
  date                    DateTime            @db.Date
  time                    String              @db.VarChar(5)
  people                  Int
  tablePreference         TablePreference     @default(ANY) @map("table_preference")
  specialRequest          String?             @map("special_request") @db.Text
  fullName                String              @map("full_name")
  mobileNumber            String              @map("mobile_number")
  email                   String?
  status                  BookingStatus       @default(UPCOMING)
  cancellationReason      CancellationReason? @map("cancellation_reason")
  cancelledAt             DateTime?           @map("cancelled_at")
  cancelledBy             BookingActor?       @map("cancelled_by")
  rejectionReason         String?             @map("rejection_reason") @db.VarChar(500)
  rejectedAt              DateTime?           @map("rejected_at")
  acknowledgedAt          DateTime?           @map("acknowledged_at")
  preparingAt             DateTime?           @map("preparing_at")
  readyAt                 DateTime?           @map("ready_at")
  completedAt             DateTime?           @map("completed_at")
  advancePaid             Decimal             @map("advance_paid") @db.Decimal(10, 2)
  paymentId               String              @unique @map("payment_id")
  tableId                 String?             @map("table_id")
  refundEligible          Boolean?            @map("refund_eligible")
  refundAmount            Decimal?            @map("refund_amount") @db.Decimal(10, 2)
  reminderJobId           String?             @map("reminder_job_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  restaurantUser RestaurantUser   @relation(fields: [restaurantUserId], references: [id])
  payment        Payment          @relation(fields: [paymentId], references: [id])
  table          DiningTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  preorder       BookingPreorder?
  notifications  Notification[]
  review         RestaurantReview?

  @@index([restaurantId, date, time])
  @@index([tableId, date, time])
  @@index([restaurantUserId, status])
  @@index([status, date])
  @@index([restaurantId, createdAt])
  @@map("restaurant_bookings")
}

model RestaurantWishlist {
  id               String   @id @default(uuid())
  restaurantUserId String   @map("restaurant_user_id")
  restaurantId     String   @map("restaurant_id")
  createdAt        DateTime @default(now()) @map("created_at")

  restaurantUser RestaurantUser @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantUserId, restaurantId])
  @@index([restaurantId])
  @@map("restaurant_wishlists")
}

model RestaurantReview {
  id               String   @id @default(uuid())
  restaurantUserId String   @map("restaurant_user_id")
  restaurantId     String   @map("restaurant_id")
  bookingId        String   @unique @map("booking_id")
  rating           Int
  comment          String   @default("") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  restaurantUser RestaurantUser    @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  booking        RestaurantBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("restaurant_reviews")
}

model BookingPreorder {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  subtotal  Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking RestaurantBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items   BookingPreorderItem[]

  @@map("booking_preorders")
}

model BookingPreorderItem {
  id           String   @id @default(uuid())
  preorderId   String   @map("preorder_id")
  menuItemId   String   @map("menu_item_id")
  itemName     String   @map("item_name")
  /// Item name translations as they were when the order was placed, e.g. { "hi": { "name": "..." } }.
  translations Json?
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity     Int
  note         String?  @db.Text
  lineTotal    Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  preorder BookingPreorder @relation(fields: [preorderId], references: [id], onDelete: Cascade)

  @@index([preorderId])
  @@index([menuItemId])
  @@map("booking_preorder_items")
}

model Payment {
  id                String        @id @default(uuid())
  restaurantUserId  String        @map("restaurant_user_id")
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  restaurantUser RestaurantUser     @relation(fields: [restaurantUserId], references: [id])
  booking        RestaurantBooking?

  @@index([restaurantUserId])
  @@map("payments")
}

model Notification {
  id               String           @id @default(uuid())
  restaurantUserId String           @map("restaurant_user_id")
  type             NotificationType
  bookingId        String?          @map("booking_id")
  title            String
  body             String           @db.Text
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at")

  restaurantUser RestaurantUser     @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)
  booking        RestaurantBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([restaurantUserId, isRead])
  @@index([bookingId])
  @@map("notifications")
}
